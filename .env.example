# =============================================================================
# Yuni AI — Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit .env to git.
# =============================================================================

# --- Application ---
YUNI_ENV=dev                          # dev | recette | recette_mock | preprod | prod
APP_NAME=yuni-ai
APP_VERSION=0.3.0
LOG_LEVEL=debug                       # debug | info | warning | error

# --- AI Providers ---
MISTRAL_API_KEY=sk-...                # Mistral Large 2 API key
OPENAI_API_KEY=sk-...                 # Fallback GPT-4o (optional in dev)

# --- Qdrant ---
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=                        # Vide en dev, requis en Qdrant Cloud

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Security ---
JWT_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_PER_MINUTE=20
ANONYMIZATION_SALT=change-me-in-prod  # Used to hash user_id (SHA-256)

# --- Yunicity APIs ---
YUNICITY_API_BASE_URL=http://localhost:4000   # Mock server in dev
YUNICITY_SERVICE_TOKEN=mock-token-dev

# --- Rollout ---
ROLLOUT_PERCENTAGE=10
ROLLOUT_CITIES=reims
ADMIN_BYPASS_TOKEN=                    # Laisser vide en dev
INTERNAL_METRICS_TOKEN=                # Token pour GET /internal/metrics

# --- Stripe (test mode in dev/recette) ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
