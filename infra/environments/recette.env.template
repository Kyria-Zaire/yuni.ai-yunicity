# =============================================================================
# Yuni AI — Railway Recette Environment Variables
# Configure these in Railway dashboard (Settings > Variables)
# =============================================================================

YUNI_ENV=recette
APP_NAME=yuni-ai
APP_VERSION=0.2.0
LOG_LEVEL=info

# --- AI ---
MISTRAL_API_KEY=                       # Cle Mistral reelle

# --- Redis (fourni par Railway Redis plugin) ---
REDIS_URL=                             # Auto-configure par Railway

# --- Security ---
JWT_PUBLIC_KEY=                        # Cle publique RSA Yunicity recette
ALLOWED_HOSTS=yuni-ai-recette.up.railway.app
CORS_ORIGINS=https://yunicity-recette.example.com
RATE_LIMIT_PER_MINUTE=20
ANONYMIZATION_SALT=                    # python -c "import secrets; print(secrets.token_hex(32))"

# --- Yunicity ---
YUNICITY_API_BASE_URL=                 # URL API Yunicity recette
YUNICITY_SERVICE_TOKEN=                # Token service dedie

# --- Rollout ---
ROLLOUT_PERCENTAGE=10
ROLLOUT_CITIES=reims
ADMIN_BYPASS_TOKEN=                    # Token admin pour bypass rollout
INTERNAL_METRICS_TOKEN=                # Token pour GET /internal/metrics

# --- Stripe (test mode) ---
STRIPE_SECRET_KEY=sk_test_
STRIPE_WEBHOOK_SECRET=whsec_
STRIPE_PUBLISHABLE_KEY=pk_test_
