# =============================================================================
# Yuni AI — Production Environment Variables
# Configure in Railway dashboard — NEVER commit real values
# =============================================================================

YUNI_ENV=prod
APP_NAME=yuni-ai
APP_VERSION=1.1.0
LOG_LEVEL=warning

# --- AI ---
MISTRAL_API_KEY=                       # Cle Mistral reelle production

# --- Qdrant ---
QDRANT_URL=                            # Qdrant Cloud URL (pas localhost)
QDRANT_API_KEY=                        # Cle API Qdrant Cloud

# --- Redis ---
REDIS_URL=                             # Auto-configure par Railway Redis plugin

# --- Security ---
JWT_PUBLIC_KEY=                        # Cle publique RSA Yunicity production
ALLOWED_HOSTS=yuni-ai.up.railway.app
CORS_ORIGINS=https://app.yunicity.com
RATE_LIMIT_PER_MINUTE=20
ANONYMIZATION_SALT=                    # Generer avec secrets.token_hex(32)

# --- Yunicity ---
YUNICITY_API_BASE_URL=https://api.yunicity.com
YUNICITY_SERVICE_TOKEN=                # Token service production

# --- Rollout ---
ROLLOUT_PERCENTAGE=100
ROLLOUT_CITIES=reims
ADMIN_BYPASS_TOKEN=                    # Token admin production
INTERNAL_METRICS_TOKEN=                # Token metriques production

# --- Stripe (production keys) ---
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PUBLISHABLE_KEY=pk_live_...
